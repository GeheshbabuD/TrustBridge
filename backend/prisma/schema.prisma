  @@index([reviewerId, reviewedAt], map: "ai_analyses_reviewer_reviewed_idx")
  @@map("ai_analyses")
}

// Chain records retain hashes/references only; transaction hash is not proof
// of confirmation/finality. Multiple operations may target one transaction.
model BlockchainRecord {
  id                String                    @id @default(uuid()) @db.Uuid
  transactionId     String                    @map("transaction_id") @db.Uuid
  status            BlockchainOperationStatus @default(PENDING)
  network           String                    @db.VarChar(80)
  contractReference String?                   @map("contract_reference") @db.VarChar(255)
  operationType     String                    @map("operation_type") @db.VarChar(80)
  transactionHash   String?                   @map("transaction_hash") @db.VarChar(128)
  blockNumber       BigInt?                   @map("block_number")
  blockHash         String?                   @map("block_hash") @db.VarChar(128)
  eventHash         String                    @map("event_hash") @db.Char(64)
  idempotencyKey    String                    @map("idempotency_key") @db.VarChar(128)
  errorCode         String?                   @map("error_code") @db.VarChar(100)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt       DateTime?                 @map("submitted_at") @db.Timestamptz(6)
  confirmedAt       DateTime?                 @map("confirmed_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, idempotencyKey], map: "blockchain_records_transaction_idempotency_key")
  @@unique([network, transactionHash], map: "blockchain_records_network_transaction_hash_key")
  @@index([transactionId, status, createdAt], map: "blockchain_records_transaction_status_created_idx")
  @@index([network, status, createdAt], map: "blockchain_records_network_status_created_idx")
  @@index([eventHash], map: "blockchain_records_event_hash_idx")
  @@map("blockchain_records")
}

// Only a one-way token hash is persisted. Self-reference retains rotation
// lineage and supports future reuse detection; raw credentials are never stored.
model RefreshToken {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  tokenHash        String            @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  familyId         String            @map("family_id") @db.Uuid
  authVersion      Int               @default(0) @map("auth_version")
  mfaVerifiedAt    DateTime?         @map("mfa_verified_at") @db.Timestamptz(6)
  assuranceLevel   MfaAssuranceLevel @default(PASSWORD_ONLY) @map("assurance_level")
  rotatedFromId    String?           @unique(map: "refresh_tokens_rotated_from_key") @map("rotated_from_id") @db.Uuid
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?           @map("revocation_reason") @db.VarChar(100)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?         @map("last_used_at") @db.Timestamptz(6)
  reuseDetectedAt  DateTime?         @map("reuse_detected_at") @db.Timestamptz(6)

  user             User           @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rotatedFrom      RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rotatedTo        RefreshToken?  @relation("RefreshTokenRotation")
  stepUpChallenges MfaChallenge[] @relation("MfaChallengeSession")

  @@index([userId, expiresAt], map: "refresh_tokens_user_expiry_idx")
  @@index([userId, revokedAt], map: "refresh_tokens_user_revocation_idx")
  @@index([familyId, revokedAt], map: "refresh_tokens_family_revocation_idx")
  @@map("refresh_tokens")
}

// Immutable-by-policy status history. A version per transaction gives transition
// writes an optimistic-concurrency uniqueness guard; DB grants/triggers are still needed.
model TransactionStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  transactionId  String             @map("transaction_id") @db.Uuid
  version        Int
  previousStatus TransactionStatus? @map("previous_status")
  newStatus      TransactionStatus  @map("new_status")
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  reason         String             @db.VarChar(1000)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor       User?       @relation("TransactionHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, version], map: "transaction_status_history_transaction_version_key")
  @@index([transactionId, createdAt], map: "transaction_status_history_transaction_created_idx")
  @@index([actorUserId, createdAt], map: "transaction_status_history_actor_created_idx")
  @@index([newStatus, createdAt], map: "transaction_status_history_status_created_idx")
  @@map("transaction_status_history")
}

// Durable provider inbox. eventData is only an allowlisted/redacted minimal
// envelope, never the raw provider request or signature/authentication headers.
model WebhookEvent {
  id                   String                  @id @default(uuid()) @db.Uuid
  provider             String                  @db.VarChar(64)
  providerAccountScope String                  @default("default") @map("provider_account_scope") @db.VarChar(128)
  eventId              String                  @map("event_id") @db.VarChar(255)
  eventType            String                  @map("event_type") @db.VarChar(128)
  paymentAttemptId     String?                 @map("payment_attempt_id") @db.Uuid
  receivedAt           DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  status               WebhookProcessingStatus @default(RECEIVED)
  attemptCount         Int                     @default(0) @map("attempt_count")
  nextAttemptAt        DateTime?               @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt            DateTime?               @map("claimed_at") @db.Timestamptz(6)
  leaseOwner           String?                 @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt       DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  eventData            Json?                   @map("event_data") @db.JsonB
  lastErrorCode        String?                 @map("last_error_code") @db.VarChar(100)
  processedAt          DateTime?               @map("processed_at") @db.Timestamptz(6)

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerAccountScope, eventId], map: "webhook_events_provider_account_event_key")
  @@index([status, nextAttemptAt, receivedAt], map: "webhook_events_status_retry_received_idx")
  @@index([provider, status, receivedAt], map: "webhook_events_provider_status_received_idx")
  @@index([paymentAttemptId, receivedAt], map: "webhook_events_payment_attempt_received_idx")
  @@map("webhook_events")
}

// Scope+key uniqueness arbitrates concurrent requests. Store only a keyed
// request fingerprint, never the request body; leases support abandoned-work recovery.
model IdempotencyOperation {
  id                 String            @id @default(uuid()) @db.Uuid
  operationScope     String            @map("operation_scope") @db.VarChar(128)
  idempotencyKey     String            @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String            @map("request_fingerprint") @db.Char(64)
  status             IdempotencyStatus @default(IN_PROGRESS)
  resourceType       String?           @map("resource_type") @db.VarChar(100)
  resourceId         String?           @map("resource_id") @db.VarChar(128)
  attemptCount       Int               @default(0) @map("attempt_count")
  leaseOwner         String?           @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt     DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey], map: "idempotency_operations_scope_key_key")
  @@index([status, leaseExpiresAt, createdAt], map: "idempotency_operations_status_lease_created_idx")
  @@index([resourceType, resourceId], map: "idempotency_operations_resource_idx")
  @@index([expiresAt], map: "idempotency_operations_expiry_idx")
  @@map("idempotency_operations")
}

// Transactional-outbox rows are inserted in the same DB transaction as their
// aggregate update. Workers claim a bounded lease before publishing/retrying.
model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  eventKey       String       @unique(map: "outbox_events_event_key_key") @map("event_key") @db.VarChar(128)
  eventType      String       @map("event_type") @db.VarChar(128)
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String       @map("aggregate_id") @db.VarChar(128)
  transactionId  String?      @map("transaction_id") @db.Uuid
  payload        Json         @db.JsonB
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  leaseOwner     String?      @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?      @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt, createdAt], map: "outbox_events_status_retry_created_idx")
  @@index([aggregateType, aggregateId, createdAt], map: "outbox_events_aggregate_created_idx")
  @@index([transactionId, createdAt], map: "outbox_events_transaction_created_idx")
  @@map("outbox_events")
}
