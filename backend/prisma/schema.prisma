model RiskAssessment {
  id              String         @id @default(uuid()) @db.Uuid
  transactionId   String         @map("transaction_id") @db.Uuid
  status          AiReviewStatus @default(PENDING)
  score           Int?
  riskLevel       String         @map("risk_level") @db.VarChar(32)
  indicators      Json           @db.JsonB
  recommendation  String?        @db.VarChar(100)
  rulesetVersion  String         @map("ruleset_version") @db.VarChar(100)
  reviewerId      String?        @map("reviewer_id") @db.Uuid
  reviewRationale String?        @map("review_rationale") @db.VarChar(2000)
  reviewOutcome   String?        @map("review_outcome") @db.VarChar(100)
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer    User?       @relation("RiskAssessmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([transactionId, status, createdAt], map: "risk_assessments_transaction_status_created_idx")
  @@index([reviewerId, reviewedAt], map: "risk_assessments_reviewer_reviewed_idx")
  @@index([status, createdAt], map: "risk_assessments_status_created_idx")
  @@map("risk_assessments")
}

// AI output is untrusted, advisory data. At least one subject relation is
