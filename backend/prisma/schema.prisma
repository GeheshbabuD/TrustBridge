model AIAnalysis {
  id              String         @id @default(uuid()) @db.Uuid
  transactionId   String?        @map("transaction_id") @db.Uuid
  disputeId       String?        @map("dispute_id") @db.Uuid
  status          AiReviewStatus @default(PENDING)
  provider        String         @db.VarChar(64)
  modelIdentifier String         @map("model_identifier") @db.VarChar(128)
  modelVersion    String         @map("model_version") @db.VarChar(128)
  analysisType    String         @map("analysis_type") @db.VarChar(80)
  result          Json           @db.JsonB
  explainability  Json?          @db.JsonB
  reviewerId      String?        @map("reviewer_id") @db.Uuid
  reviewRationale String?        @map("review_rationale") @db.VarChar(2000)
  reviewOutcome   String?        @map("review_outcome") @db.VarChar(100)
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispute     Dispute?     @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer    User?        @relation("AIAnalysisReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([transactionId, status, createdAt], map: "ai_analyses_transaction_status_created_idx")
  @@index([disputeId, status, createdAt], map: "ai_analyses_dispute_status_created_idx")
