// Canonical Prisma schema for TrustBridge 2.0.
// PostgreSQL is authoritative; model-specific constraints and relations are
// introduced in their assigned tasks rather than placeholder models.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Account roles grant application-level privileges. Transaction party roles
// are separate because one account may participate in different capacities.
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ParticipantRole {
  BUYER
  SELLER
}

enum MfaChallengePurpose {
  LOGIN
  STEP_UP
  ACCOUNT_RECOVERY
  LEGACY_ADMIN_MFA_ENROLL
  LEGACY_ADMIN_MFA_VERIFY
}

enum MfaAssuranceLevel {
  PASSWORD_ONLY
  TOTP_VERIFIED
  RECOVERY_CODE_VERIFIED
}

enum AccountRecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum RecoveryApprovalDecision {
  APPROVE
  REJECT
}

enum MfaEnrollmentStatus {
  DISABLED
  PENDING
  ENABLED
}

// These values describe transaction status only. Payment attempt outcomes are
// modeled separately and are never substituted for transaction transitions.
// The allowed transition graph is enforced by application services, not enums.
enum TransactionStatus {
  CREATED
  ACCEPTED
  AWAITING_PAYMENT
  FUNDED
  IN_PROGRESS
  DELIVERED
  DISPUTED
  RELEASE_PENDING
  REFUND_PENDING
  COMPLETED
  REFUNDED
  CANCELLED
  REJECTED
}

enum TermsVersionStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  // Marks a snapshot inferred from a transaction that was already beyond
  // CREATED before explicit terms decisions were persisted.
  LEGACY_ACCEPTED
}

enum TermsDecision {
  ACCEPTED
  REJECTED
}

enum TransactionInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  CANCELLED
}

// These are internal workflow labels and do not imply legal custody of funds.
enum EscrowStatus {
  UNFUNDED
  FUNDED
  RELEASE_PENDING
  REFUND_PENDING
  RELEASED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DisputeActivityType {
  OPENED
  REVIEW_STARTED
  RESPONSE
  EVIDENCE_ADDED
  RESOLVED
  CLOSED
}

enum DeliveryDecisionType {
  ACCEPTED
  CHANGES_REQUESTED
}

enum ProviderOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum EscrowOperationType {
  FUNDING
  RELEASE
  REFUND
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// AI review concerns an advisory recommendation only. No review state grants
// authority to move funds or issue a final dispute ruling.
enum AiReviewStatus {
  PENDING
  REVIEWED
  OVERRIDDEN
}

enum BlockchainOperationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerReconciliationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum LedgerReconciliationTriggerType {
  MANUAL
  SCHEDULED
}

enum LedgerReconciliationItemStatus {
  PENDING
  PROCESSING
  CONSISTENT
  DISCREPANCY
  FAILED
}

enum LedgerReconciliationFindingStatus {
  OPEN
  RESOLVED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  // Persist a canonical lowercase/trimmed email; ingress normalization belongs
  // to the identity service. The unique constraint protects stored values.
  email        String     @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  authVersion  Int        @default(0) @map("auth_version")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                        Profile?
  buyerTransactions              Transaction[]              @relation("TransactionBuyer")
  sellerTransactions             Transaction[]              @relation("TransactionSeller")
  createdTransactions            Transaction[]              @relation("TransactionCreator")
  transactionParticipants        TransactionParticipant[]
  openedDisputes                 Dispute[]                  @relation("DisputeOpenedBy")
  resolvedDisputes               Dispute[]                  @relation("DisputeResolvedBy")
  uploadedEvidence               Evidence[]                 @relation("EvidenceUploader")
  disputeActivities              DisputeActivity[]
  notifications                  Notification[]             @relation("NotificationRecipient")
  auditLogs                      AuditLog[]                 @relation("AuditActor")
  riskAssessmentsReviewed        RiskAssessment[]           @relation("RiskAssessmentReviewer")
  aiAnalysesReviewed             AIAnalysis[]               @relation("AIAnalysisReviewer")
  refreshTokens                  RefreshToken[]             @relation("RefreshTokenUser")
  transactionStatusHistory       TransactionStatusHistory[] @relation("TransactionHistoryActor")
  mfa                            UserMfa?
  mfaChallenges                  MfaChallenge[]
  mfaRecoveryCodes               MfaRecoveryCode[]
  accountRecoveryRequests        AccountRecoveryRequest[]   @relation("RecoverySubject")
  initiatedRecoveryRequests      AccountRecoveryRequest[]   @relation("RecoveryRequester")
  recoveryApprovals              RecoveryApproval[]
  proposedTransactionTerms       TransactionTermsVersion[]  @relation("TransactionTermsProposer")
  transactionTermsDecisions      TransactionTermsDecision[] @relation("TransactionTermsDecisionActor")
  sentTransactionInvitations     TransactionInvitation[]    @relation("TransactionInvitationInviter")
  receivedTransactionInvitations TransactionInvitation[]    @relation("TransactionInvitationInvitee")
  escrowOperations               EscrowOperation[]          @relation("EscrowOperationActor")
  submittedDeliveries            TransactionDelivery[]      @relation("DeliverySubmitter")
  deliveryDecisions              DeliveryDecision[]         @relation("DeliveryDecisionActor")
  reconciliationRuns             LedgerReconciliationRun[]  @relation("ReconciliationRunRequester")

  @@index([status, createdAt], map: "users_status_created_at_idx")
  @@index([role, status], map: "users_role_status_idx")
  @@map("users")
}

model Profile {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique(map: "profiles_user_id_key") @map("user_id") @db.Uuid
  displayName             String?  @map("display_name") @db.VarChar(120)
  preferences             Json     @default("{}") @db.JsonB
  notificationPreferences Json     @default("{}") @map("notification_preferences") @db.JsonB
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("profiles")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  buyerId     String            @map("buyer_id") @db.Uuid
  sellerId    String            @map("seller_id") @db.Uuid
  createdById String            @map("created_by_id") @db.Uuid
  status      TransactionStatus @default(CREATED)
  amountMinor BigInt            @map("amount_minor")
  currency    String            @db.Char(3)
  terms       Json              @db.JsonB
  version     Int               @default(1)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer                  User                          @relation("TransactionBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller                 User                          @relation("TransactionSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User                          @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participants           TransactionParticipant[]
  paymentAttempts        PaymentAttempt[]
  escrow                 Escrow?
  ledgerAccounts         LedgerAccount[]
  ledgerJournals         LedgerJournal[]
  disputes               Dispute[]
  riskAssessments        RiskAssessment[]
  aiAnalyses             AIAnalysis[]
  blockchainRecords      BlockchainRecord[]
  statusHistory          TransactionStatusHistory[]
  outboxEvents           OutboxEvent[]
  termsVersions          TransactionTermsVersion[]
  invitations            TransactionInvitation[]
  escrowOperations       EscrowOperation[]
  deliveries             TransactionDelivery[]
  reconciliationItems    LedgerReconciliationRunItem[]
  reconciliationFindings LedgerReconciliationFinding[]

  // Composite references below keep all transaction-bound financial rows in
  // this transaction's currency. id is already primary; this key supports FKs.
  @@unique([id, currency], map: "transactions_id_currency_key")
  @@index([buyerId, status, createdAt], map: "transactions_buyer_status_created_idx")
  @@index([sellerId, status, createdAt], map: "transactions_seller_status_created_idx")
  @@index([status, createdAt], map: "transactions_status_created_idx")
  @@index([createdById, createdAt], map: "transactions_creator_created_idx")
  @@map("transactions")
}

model TransactionTermsVersion {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @map("transaction_id") @db.Uuid
  version       Int
  proposedById  String             @map("proposed_by_id") @db.Uuid
  amountMinor   BigInt             @map("amount_minor")
  currency      String             @db.Char(3)
  details       Json               @db.JsonB
  status        TermsVersionStatus @default(PENDING)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction Transaction                @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposedBy  User                       @relation("TransactionTermsProposer", fields: [proposedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisions   TransactionTermsDecision[]

  @@unique([transactionId, version], map: "transaction_terms_versions_transaction_version_key")
  @@index([transactionId, status, version], map: "transaction_terms_versions_lookup_idx")
  @@index([proposedById, createdAt], map: "transaction_terms_versions_proposer_idx")
  @@map("transaction_terms_versions")
}

model TransactionTermsDecision {
  id             String        @id @default(uuid()) @db.Uuid
  termsVersionId String        @map("terms_version_id") @db.Uuid
  actorUserId    String        @map("actor_user_id") @db.Uuid
  decision       TermsDecision
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  termsVersion TransactionTermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User                    @relation("TransactionTermsDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([termsVersionId, actorUserId], map: "transaction_terms_decisions_version_actor_key")
  @@index([actorUserId, createdAt], map: "transaction_terms_decisions_actor_created_idx")
  @@map("transaction_terms_decisions")
}

model TransactionInvitation {
  id            String                      @id @default(uuid()) @db.Uuid
  transactionId String                      @map("transaction_id") @db.Uuid
  inviterId     String                      @map("inviter_id") @db.Uuid
  inviteeId     String                      @map("invitee_id") @db.Uuid
  tokenHash     String                      @unique(map: "transaction_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status        TransactionInvitationStatus @default(PENDING)
  expiresAt     DateTime                    @map("expires_at") @db.Timestamptz(6)
  acceptedAt    DateTime?                   @map("accepted_at") @db.Timestamptz(6)
  rejectedAt    DateTime?                   @map("rejected_at") @db.Timestamptz(6)
  revokedAt     DateTime?                   @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inviter     User        @relation("TransactionInvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitee     User        @relation("TransactionInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([transactionId, status, createdAt], map: "transaction_invitations_transaction_status_idx")
  @@index([inviteeId, status, expiresAt], map: "transaction_invitations_invitee_expiry_idx")
  @@map("transaction_invitations")
}

model TransactionParticipant {
  transactionId String          @map("transaction_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  role          ParticipantRole
  joinedAt      DateTime        @default(now()) @map("joined_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([transactionId, userId], map: "transaction_participants_pkey")
  @@unique([transactionId, role], map: "transaction_participants_transaction_role_key")
  @@index([userId, role, joinedAt], map: "transaction_participants_user_role_joined_idx")
  @@map("transaction_participants")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  transactionId     String               @map("transaction_id") @db.Uuid
  provider          String               @db.VarChar(64)
  providerReference String?              @map("provider_reference") @db.VarChar(255)
  capturedPaymentId String?              @map("captured_payment_id") @db.VarChar(255)
  idempotencyKey    String               @map("idempotency_key") @db.VarChar(128)
  status            PaymentAttemptStatus @default(CREATED)
  amountMinor       BigInt               @map("amount_minor")
  currency          String               @db.Char(3)
  failureCode       String?              @map("failure_code") @db.VarChar(100)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction      Transaction       @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  webhookEvents    WebhookEvent[]
  escrowOperations EscrowOperation[]

  @@unique([transactionId, idempotencyKey], map: "payment_attempts_transaction_idempotency_key")
  @@unique([provider, providerReference], map: "payment_attempts_provider_reference_key")
  @@unique([provider, capturedPaymentId], map: "payment_attempts_provider_captured_payment_key")
  @@index([transactionId, status, createdAt], map: "payment_attempts_transaction_status_created_idx")
  @@index([provider, status], map: "payment_attempts_provider_status_idx")
  @@map("payment_attempts")
}

// Internal workflow/accounting record only; it does not represent legal custody.
model Escrow {
  id            String       @id @default(uuid()) @db.Uuid
  transactionId String       @map("transaction_id") @db.Uuid
  currency      String       @db.Char(3)
  balanceMinor  BigInt       @default(0) @map("balance_minor")
  status        EscrowStatus @default(UNFUNDED)
  fundedAt      DateTime?    @map("funded_at") @db.Timestamptz(6)
  releasedAt    DateTime?    @map("released_at") @db.Timestamptz(6)
  refundedAt    DateTime?    @map("refunded_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction   Transaction       @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  ledgerAccount LedgerAccount?    @relation("EscrowLedgerAccount")
  operations    EscrowOperation[]

  @@unique([id, transactionId, currency], map: "escrows_id_transaction_currency_key")
  @@unique([transactionId, currency], map: "escrows_transaction_currency_key")
  @@index([status, updatedAt], map: "escrows_status_updated_idx")
  @@map("escrows")
}

model LedgerAccount {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  escrowId      String?           @map("escrow_id") @db.Uuid
  accountCode   String            @map("account_code") @db.VarChar(64)
  accountType   LedgerAccountType @map("account_type")
  currency      String            @db.Char(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction Transaction   @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  escrow      Escrow?       @relation("EscrowLedgerAccount", fields: [escrowId, transactionId, currency], references: [id, transactionId, currency], onDelete: Restrict, onUpdate: Restrict)
  entries     LedgerEntry[]

  @@unique([transactionId, accountCode, currency], map: "ledger_accounts_transaction_code_currency_key")
  @@unique([id, transactionId, currency], map: "ledger_accounts_id_transaction_currency_key")
  @@unique([escrowId, transactionId, currency], map: "ledger_accounts_escrow_transaction_currency_key")
  @@index([transactionId, accountType, currency], map: "ledger_accounts_transaction_type_currency_idx")
  @@map("ledger_accounts")
}

model LedgerJournal {
  id                  String   @id @default(uuid()) @db.Uuid
  transactionId       String   @map("transaction_id") @db.Uuid
  operationId         String   @unique(map: "ledger_journals_operation_id_key") @map("operation_id") @db.VarChar(128)
  currency            String   @db.Char(3)
  reversalOfJournalId String?  @map("reversal_of_journal_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction      Transaction       @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  entries          LedgerEntry[]
  reversalOf       LedgerJournal?    @relation("LedgerJournalReversal", fields: [reversalOfJournalId, transactionId, currency], references: [id, transactionId, currency], onDelete: Restrict, onUpdate: Restrict)
  reversals        LedgerJournal[]   @relation("LedgerJournalReversal")
  escrowOperations EscrowOperation[]

  @@unique([id, transactionId, currency], map: "ledger_journals_id_transaction_currency_key")
  @@index([transactionId, createdAt], map: "ledger_journals_transaction_created_idx")
  @@index([reversalOfJournalId], map: "ledger_journals_reversal_idx")
  @@map("ledger_journals")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  journalId     String          @map("journal_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  currency      String          @db.Char(3)
  amountMinor   BigInt          @map("amount_minor")
  direction     LedgerDirection
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  journal LedgerJournal @relation(fields: [journalId, transactionId, currency], references: [id, transactionId, currency], onDelete: Restrict, onUpdate: Restrict)
  account LedgerAccount @relation(fields: [accountId, transactionId, currency], references: [id, transactionId, currency], onDelete: Restrict, onUpdate: Restrict)

  @@index([journalId, transactionId, currency], map: "ledger_entries_journal_transaction_currency_idx")
  @@index([accountId, transactionId, currency, createdAt], map: "ledger_entries_account_transaction_currency_created_idx")
  @@map("ledger_entries")
}

// Operational reconciliation metadata only. These records have no financial
// posting relations and must never be used to mutate payment, escrow or ledger state.
model LedgerReconciliationRun {
  id                 String                          @id @default(uuid()) @db.Uuid
  idempotencyKey     String                          @unique(map: "ledger_reconciliation_runs_idempotency_key") @map("idempotency_key") @db.VarChar(128)
  triggerType        LedgerReconciliationTriggerType @map("trigger_type")
  status             LedgerReconciliationRunStatus   @default(QUEUED)
  requestedById      String?                         @map("requested_by_id") @db.Uuid
  cutoffAt           DateTime                        @default(now()) @map("cutoff_at") @db.Timestamptz(6)
  itemLimit          Int                             @map("item_limit")
  pageSize           Int                             @map("page_size")
  candidateCount     Int                             @default(0) @map("candidate_count")
  scannedCount       Int                             @default(0) @map("scanned_count")
  consistentCount    Int                             @default(0) @map("consistent_count")
  discrepancyCount   Int                             @default(0) @map("discrepancy_count")
  failedCount        Int                             @default(0) @map("failed_count")
  continuationCursor String?                         @map("continuation_cursor") @db.VarChar(128)
  hasMore            Boolean                         @default(false) @map("has_more")
  attemptCount       Int                             @default(0) @map("attempt_count")
  leaseOwner         String?                         @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt     DateTime?                       @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode      String?                         @map("last_error_code") @db.VarChar(100)
  startedAt          DateTime?                       @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?                       @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy      User?                         @relation("ReconciliationRunRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            LedgerReconciliationRunItem[]
  firstFindings    LedgerReconciliationFinding[] @relation("ReconciliationFindingFirstRun")
  lastFindings     LedgerReconciliationFinding[] @relation("ReconciliationFindingLastRun")
  resolvedFindings LedgerReconciliationFinding[] @relation("ReconciliationFindingResolvedRun")

  @@index([status, leaseExpiresAt, createdAt], map: "ledger_reconciliation_runs_claim_idx")
  @@index([requestedById, createdAt], map: "ledger_reconciliation_runs_requester_idx")
  @@map("ledger_reconciliation_runs")
}

model LedgerReconciliationRunItem {
  id             String                         @id @default(uuid()) @db.Uuid
  runId          String                         @map("run_id") @db.Uuid
  transactionId  String                         @map("transaction_id") @db.Uuid
  ordinal        Int
  status         LedgerReconciliationItemStatus @default(PENDING)
  attemptCount   Int                            @default(0) @map("attempt_count")
  snapshotAt     DateTime                       @default(now()) @map("snapshot_at") @db.Timestamptz(6)
  claimedAt      DateTime?                      @map("claimed_at") @db.Timestamptz(6)
  leaseOwner     String?                        @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime?                      @map("lease_expires_at") @db.Timestamptz(6)
  retryAt        DateTime?                      @map("retry_at") @db.Timestamptz(6)
  lastErrorCode  String?                        @map("last_error_code") @db.VarChar(100)
  completedAt    DateTime?                      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  run         LedgerReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transaction Transaction             @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, transactionId], map: "ledger_reconciliation_run_items_run_transaction_key")
  @@unique([runId, ordinal], map: "ledger_reconciliation_run_items_run_ordinal_key")
  @@index([runId, status, retryAt, ordinal], map: "ledger_reconciliation_run_items_claim_idx")
  @@index([transactionId, snapshotAt], map: "ledger_reconciliation_run_items_transaction_snapshot_idx")
  @@map("ledger_reconciliation_run_items")
}

model LedgerReconciliationFinding {
  id              String                            @id @default(uuid()) @db.Uuid
  transactionId   String                            @map("transaction_id") @db.Uuid
  discrepancyCode String                            @map("discrepancy_code") @db.VarChar(100)
  status          LedgerReconciliationFindingStatus @default(OPEN)
  occurrenceCount Int                               @default(1) @map("occurrence_count")
  expectedCount   Int?                              @map("expected_count")
  observedCount   Int?                              @map("observed_count")
  firstSeenAt     DateTime                          @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime                          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt      DateTime?                         @map("resolved_at") @db.Timestamptz(6)
  firstRunId      String?                           @map("first_run_id") @db.Uuid
  lastRunId       String?                           @map("last_run_id") @db.Uuid
  resolvedByRunId String?                           @map("resolved_by_run_id") @db.Uuid
  createdAt       DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction   Transaction              @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firstRun      LedgerReconciliationRun? @relation("ReconciliationFindingFirstRun", fields: [firstRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastRun       LedgerReconciliationRun? @relation("ReconciliationFindingLastRun", fields: [lastRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedByRun LedgerReconciliationRun? @relation("ReconciliationFindingResolvedRun", fields: [resolvedByRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, discrepancyCode], map: "ledger_reconciliation_findings_transaction_code_key")
  @@index([status, lastSeenAt], map: "ledger_reconciliation_findings_status_seen_idx")
  @@index([firstRunId], map: "ledger_reconciliation_findings_first_run_idx")
