// Durable authorization/execution envelope. Provider execution is separate;
// internal escrow remains an accounting record, not legal custody.
model EscrowOperation {
  id                String                  @id @default(uuid()) @db.Uuid
  transactionId     String                  @map("transaction_id") @db.Uuid
  escrowId          String                  @map("escrow_id") @db.Uuid
  paymentAttemptId  String?                 @unique(map: "escrow_operations_payment_attempt_key") @map("payment_attempt_id") @db.Uuid
  ledgerJournalId   String?                 @unique(map: "escrow_operations_ledger_journal_key") @map("ledger_journal_id") @db.Uuid
  actorUserId       String?                 @map("actor_user_id") @db.Uuid
  type              EscrowOperationType
  status            ProviderOperationStatus @default(PENDING)
  idempotencyKey    String                  @map("idempotency_key") @db.VarChar(128)
  operationKey      String                  @unique(map: "escrow_operations_operation_key_key") @map("operation_key") @db.VarChar(160)
  provider          String?                 @db.VarChar(64)
  providerReference String?                 @map("provider_reference") @db.VarChar(255)
  amountMinor       BigInt                  @map("amount_minor")
  currency          String                  @db.Char(3)
  reasonCode        String                  @map("reason_code") @db.VarChar(100)
  failureCode       String?                 @map("failure_code") @db.VarChar(100)
  attemptCount      Int                     @default(0) @map("attempt_count")
  nextAttemptAt     DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner        String?                 @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt    DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  authorizedAt      DateTime                @default(now()) @map("authorized_at") @db.Timestamptz(6)
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction    Transaction     @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  escrow         Escrow          @relation(fields: [escrowId, transactionId, currency], references: [id, transactionId, currency], onDelete: Restrict, onUpdate: Restrict)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerJournal  LedgerJournal?  @relation(fields: [ledgerJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?           @relation("EscrowOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, idempotencyKey], map: "escrow_operations_transaction_idempotency_key")
  @@index([transactionId, type, status, createdAt], map: "escrow_operations_transaction_type_status_idx")
  @@index([escrowId, status, createdAt], map: "escrow_operations_escrow_status_created_idx")
  @@index([status, updatedAt], map: "escrow_operations_status_updated_idx")
  @@index([status, nextAttemptAt, leaseExpiresAt], map: "escrow_operations_retry_lease_idx")
  @@map("escrow_operations")
}

model Dispute {
  id                    String        @id @default(uuid()) @db.Uuid
  transactionId         String        @map("transaction_id") @db.Uuid
  openedById            String        @map("opened_by_id") @db.Uuid
  resolvedById          String?       @map("resolved_by_id") @db.Uuid
  status                DisputeStatus @default(OPEN)
  category              String        @db.VarChar(80)
  description           String        @db.VarChar(4000)
  resolution            String?       @db.VarChar(4000)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(6)
  closedAt              DateTime?     @map("closed_at") @db.Timestamptz(6)
  version               Int           @default(1)
  evidenceDeadlineAt    DateTime?     @map("evidence_deadline_at") @db.Timestamptz(6)
  responseDeadlineAt    DateTime?     @map("response_deadline_at") @db.Timestamptz(6)
  resolutionAmountMinor BigInt?       @map("resolution_amount_minor")

  transaction Transaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedBy    User              @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy  User?             @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evidence    Evidence[]
  activities  DisputeActivity[]
  aiAnalyses  AIAnalysis[]

  // The domain design allows multiple disputes over a transaction lifecycle;
  // status and authorization policy determine whether a new dispute is valid.
  @@index([transactionId, status, createdAt], map: "disputes_transaction_status_created_idx")
  @@index([openedById, createdAt], map: "disputes_opener_created_idx")
  @@index([resolvedById, resolvedAt], map: "disputes_resolver_resolved_idx")
  @@index([status, createdAt], map: "disputes_status_created_idx")
  @@map("disputes")
}

model TransactionDelivery {
