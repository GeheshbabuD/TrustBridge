  dispute    Dispute?             @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delivery   TransactionDelivery? @relation(fields: [transactionDeliveryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User                 @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([disputeId, createdAt], map: "evidence_dispute_created_idx")
  @@index([transactionDeliveryId, createdAt], map: "evidence_delivery_created_idx")
  @@index([uploadedById, createdAt], map: "evidence_uploader_created_idx")
  @@map("evidence")
}

