// Append-only by policy; database grants/triggers and service redaction are
// required because Prisma schema declarations alone cannot prevent mutation.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.VarChar(128)
  requestId   String?  @map("request_id") @db.VarChar(128)
  // Application must write allowlisted, redacted metadata only.
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_idx")
  @@index([entityType, entityId, createdAt], map: "audit_logs_entity_created_idx")
  @@index([requestId, createdAt], map: "audit_logs_request_created_idx")
  @@index([createdAt], map: "audit_logs_created_idx")
  @@map("audit_logs")
}

// TOTP seed material is encrypted before it reaches Prisma. Pending fields
// support enrollment/replacement without disabling the currently active seed.
model UserMfa {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @unique(map: "user_mfa_user_id_key") @map("user_id") @db.Uuid
  enrollmentStatus     MfaEnrollmentStatus @default(DISABLED) @map("enrollment_status")
  secretCiphertext     Bytes?              @map("secret_ciphertext") @db.ByteA
  secretNonce          Bytes?              @map("secret_nonce") @db.ByteA
  secretAuthTag        Bytes?              @map("secret_auth_tag") @db.ByteA
  secretKeyId          String?             @map("secret_key_id") @db.VarChar(128)
  secretKeyVersion     Int?                @map("secret_key_version")
  pendingCiphertext    Bytes?              @map("pending_ciphertext") @db.ByteA
  pendingNonce         Bytes?              @map("pending_nonce") @db.ByteA
  pendingAuthTag       Bytes?              @map("pending_auth_tag") @db.ByteA
  pendingKeyId         String?             @map("pending_key_id") @db.VarChar(128)
  pendingKeyVersion    Int?                @map("pending_key_version")
  pendingExpiresAt     DateTime?           @map("pending_expires_at") @db.Timestamptz(6)
  enabledAt            DateTime?           @map("enabled_at") @db.Timestamptz(6)
  lastAcceptedTimeStep BigInt?             @map("last_accepted_time_step")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([enabledAt, updatedAt], map: "user_mfa_enabled_updated_idx")
  @@map("user_mfa")
}

// Recovery codes are high-entropy secrets; only their SHA-256 digest is stored.
model MfaRecoveryCode {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  batchId       String    @map("batch_id") @db.Uuid
  codeHash      String    @unique(map: "mfa_recovery_codes_hash_key") @map("code_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, batchId, consumedAt, invalidatedAt], map: "mfa_recovery_codes_user_batch_state_idx")
  @@map("mfa_recovery_codes")
}

// Opaque challenge hashes make in-flight authentication/recovery challenges
// restart-safe without persisting or logging the bearer challenge value.
model MfaChallenge {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  tokenHash        String              @unique(map: "mfa_challenges_token_hash_key") @map("token_hash") @db.Char(64)
  purpose          MfaChallengePurpose
  operationPurpose String?             @map("operation_purpose") @db.VarChar(80)
  authVersion      Int                 @default(0) @map("auth_version")
  attemptCount     Int                 @default(0) @map("attempt_count")
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sessionId        String?             @map("session_id") @db.Uuid
  resourceType     String?             @map("resource_type") @db.VarChar(64)
  resourceId       String?             @map("resource_id") @db.VarChar(128)
  mfaEnabledAt     DateTime?           @map("mfa_enabled_at") @db.Timestamptz(6)
  verifiedAt       DateTime?           @map("verified_at") @db.Timestamptz(6)
  grantConsumedAt  DateTime?           @map("grant_consumed_at") @db.Timestamptz(6)

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session RefreshToken? @relation("MfaChallengeSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, purpose, expiresAt], map: "mfa_challenges_user_purpose_expiry_idx")
  @@index([expiresAt, consumedAt], map: "mfa_challenges_expiry_consumed_idx")
  @@index([userId, sessionId, operationPurpose, resourceType, resourceId, verifiedAt], map: "mfa_challenges_step_up_assurance_idx")
  @@index([sessionId, consumedAt], map: "mfa_challenges_session_consumed_idx")
  @@map("mfa_challenges")
}

// Recovery approval state is durable. Independent identity verification is
// represented by an opaque verification reference, never by stored evidence.
model AccountRecoveryRequest {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  requestedByUserId       String?               @map("requested_by_user_id") @db.Uuid
  status                  AccountRecoveryStatus @default(PENDING)
  identityVerifiedAt      DateTime?             @map("identity_verified_at") @db.Timestamptz(6)
  identityVerificationRef String?               @map("identity_verification_ref") @db.VarChar(255)
  expiresAt               DateTime              @map("expires_at") @db.Timestamptz(6)
  version                 Int                   @default(1)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt             DateTime?             @map("completed_at") @db.Timestamptz(6)

  user        User               @relation("RecoverySubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User?              @relation("RecoveryRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals   RecoveryApproval[]

  @@index([userId, status, createdAt], map: "account_recovery_requests_user_status_created_idx")
  @@index([status, expiresAt], map: "account_recovery_requests_status_expiry_idx")
  @@map("account_recovery_requests")
}

model RecoveryApproval {
  id         String                   @id @default(uuid()) @db.Uuid
  requestId  String                   @map("request_id") @db.Uuid
  approverId String                   @map("approver_id") @db.Uuid
  decision   RecoveryApprovalDecision
  reasonCode String?                  @map("reason_code") @db.VarChar(80)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  request  AccountRecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver User                   @relation(fields: [approverId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, approverId], map: "recovery_approvals_request_approver_key")
  @@index([approverId, createdAt], map: "recovery_approvals_approver_created_idx")
  @@index([requestId, decision, createdAt], map: "recovery_approvals_request_decision_created_idx")
  @@map("recovery_approvals")
}

// Rules-based risk outputs are advisory and remain distinct from transaction
