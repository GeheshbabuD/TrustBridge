# Copy to .env locally and replace all placeholder values. Do not commit .env.
# NODE_ENV and PORT have development defaults. DATABASE_URL and both JWT secrets are required.
NODE_ENV=development
PORT=3000
# Comma-separated exact origins only; empty means no browser origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
RATE_LIMIT_STORE=memory
# Production requires a TLS Redis URL with an ACL username/password. Never commit real credentials.
# REDIS_URL=rediss://<acl-user>:<password>@<redis-host>:6379
# RATE_LIMIT_KEY_SECRET=<distinct-random-secret-at-least-32-characters>
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
# bcrypt work factor; valid range is 12 through 15, with 12 as the default.
BCRYPT_SALT_ROUNDS=12
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/Trustbridge?schema=public

# Generate two different random secrets, each at least 32 characters.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_ACCESS_SECRET_OF_32_CHARS_OR_MORE
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_REFRESH_SECRET_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=trustbridge-api
JWT_AUDIENCE=trustbridge-client

# TOTP enrollment uses 6 digits and 30-second steps; accepted clock skew is configurable (0-2 steps).
MFA_TOTP_WINDOW_STEPS=1
# Enrollment verification failed-attempt limit (in-memory per authenticated account).
MFA_VERIFY_RATE_LIMIT_WINDOW_MS=600000
MFA_VERIFY_RATE_LIMIT_MAX=5
# Password-only login and login-MFA challenges use in-memory IP limits (single-instance only).
MFA_CHALLENGE_RATE_LIMIT_WINDOW_MS=600000
MFA_CHALLENGE_RATE_LIMIT_MAX=5
MFA_LOGIN_CHALLENGE_TTL_SECONDS=300
MFA_STEP_UP_CHALLENGE_TTL_SECONDS=300
MFA_ASSURANCE_MAX_AGE_SECONDS=900
# Never place encryption keys here. Production must use an approved KMS-backed key provider.

# Provider credentials are optional while their integration is disabled and required when enabled.
AI_ENABLED=false
# When enabled, configure a TrustBridge JSON protocol gateway endpoint and model provenance.
# AI_PROVIDER=approved-gateway-id
# AI_ENDPOINT=https://ai-gateway.example.invalid/v1/assess
# AI_MODEL_IDENTIFIER=approved-model-id
# AI_MODEL_VERSION=approved-model-version
# AI_API_KEY=replace-with-provider-key
# AI_REQUEST_TIMEOUT_MS=5000
# AI_RATE_LIMIT_WINDOW_MS=900000
# AI_RATE_LIMIT_MAX=10

BLOCKCHAIN_ENABLED=false
# BLOCKCHAIN_RPC_URL=https://your-rpc-endpoint
# BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# BLOCKCHAIN_CHAIN_ID=11155111
# BLOCKCHAIN_CONFIRMATIONS=12 # example only; select a finality depth for the approved network

PAYMENT_ENABLED=false
# PAYMENT_PROVIDER=your-provider-id
# PAYMENT_API_KEY=replace-with-provider-key
# PAYMENT_API_SECRET=replace-with-provider-secret
# PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
# All financial execution switches remain off unless explicitly approved and configured.
ESCROW_EXECUTION_ENABLED=false
RAZORPAY_REFUNDS_APPROVED=false
RAZORPAY_ROUTE_APPROVED=false
